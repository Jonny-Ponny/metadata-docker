# .env file
HOST_PORT=8888
DEBUG=False

# Login credentials. If AUTH_USERNAME or AUTH_PASSWORD is empty, a random
# temporary credential is generated at startup and printed to the container
# logs. Set both for a stable login.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Optional alternative to AUTH_PASSWORD: a Werkzeug password hash.
# Generate one with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
#AUTH_PASSWORD_HASH=

# Optional stable secret for session tokens. Without it a new secret is
# generated on every restart, which logs everyone out. Use at least 32
# characters; generate one with: openssl rand -hex 32
#JWT_SECRET=

# OPTIONAL
#TOKEN_EXPIRE_HOURS=12

# Maximum size of a single upload request in MiB. Folder uploads are sent one
# file per request, so this limits each file, not the whole library.
#MAX_UPLOAD_MB=4096
